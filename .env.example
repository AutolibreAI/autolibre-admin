# ── Base de datos ────────────────────────────────────────────────────────────
# La misma que usa el backend hex. El panel la lee directo (decisión tomada:
# el trabajo del admin ES el SQL que ya existe — ver CLAUDE.md).
POSTGRES_DATABASE_URL=

# ── Clerk ────────────────────────────────────────────────────────────────────
# Del dashboard de Clerk → Configure → API keys.
# La publishable key lleva prefijo VITE_ porque el cliente la necesita; es
# pública por diseño. La secret key NUNCA lleva ese prefijo.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Build ────────────────────────────────────────────────────────────────────
# Preset de Nitro, leído en build time por vite.config.ts.
# node-server | vercel | netlify | cloudflare-module | bun
NITRO_PRESET=node-server

# ── TLS contra el Postgres administrado de DigitalOcean ─────────────────────
# El CA viaja como CONTENIDO, no como ruta. Un `sslrootcert=./ca-certificate.crt`
# en la URL anda en la laptop y revienta en el deploy con ENOENT: el archivo no
# entra en el bundle serverless, y `./` resuelve contra el root de la function
# (/var/task), no contra el root del repo.
#
# Aca va el PEM completo, o su base64 en una sola linea:
#   node -e "console.log(require('fs').readFileSync('ca-certificate.crt').toString('base64'))"
#
# Sin esta variable la conexion NO valida el certificado del servidor.
# La URL de abajo va SIN sslmode ni sslrootcert: src/server/db.ts los borra igual.
POSTGRES_CA_CERT=
