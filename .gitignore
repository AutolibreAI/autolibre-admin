# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# ── Build output ─────────────────────────────────────────────────────────────
# Nitro packages the server here; the preset decides the shape but the folder
# is always regenerated by `pnpm build`.
.output/
dist/
build/
.vercel/
.netlify/
.wrangler/

# ── Generated by tooling — never hand-edited, always reproducible ────────────
# TanStack Router regenerates this on dev/build from the files in src/routes.
# Committing it produces merge conflicts on every branch that adds a route.
src/routeTree.gen.ts

# ── Caches ───────────────────────────────────────────────────────────────────
.vite/
node_modules/.vite/
.nitro/
.cache/
.turbo/
.eslintcache
*.tsbuildinfo

# ── Environment & secrets ────────────────────────────────────────────────────
# `.env.example` is committed on purpose — it documents the required keys
# without carrying any value.
.env
.env.*
!.env.example

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Test & coverage ──────────────────────────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
.playwright/

# ── Editors & OS ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Local agent / scratch ────────────────────────────────────────────────────
.claude/settings.local.json
*.local
scratch/
tmp/
.vercel
.env*.local

# clerk configuration (can include secrets)
/.clerk/
